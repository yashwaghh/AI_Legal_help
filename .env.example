GOOGLE_CLOUD_PROJECT=ai-legal-help
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_MODEL=gemini-3.5-flash-lite
VERTEX_TIMEOUT_MS=45000
GENAI_ENABLED=true
MAX_PDF_BYTES=12582912
MAX_PDF_PAGES=40
MAX_EXTRACTED_CHARS=100000

# Local-only defaults. Never use these values on Cloud Run.
APP_ENV=development
AUTH_MODE=development
RATE_LIMIT_BACKEND=memory

# Production Identity Platform / Firebase Authentication configuration.
# The Firebase web API key and app ID are public client configuration, not Vertex credentials.
# Restrict the API key to this site's HTTP referrers and Identity Toolkit APIs.
FIREBASE_PROJECT_ID=ai-legal-help
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=ai-legal-help.firebaseapp.com
FIREBASE_APP_ID=
APP_CHECK_REQUIRED=false
FIREBASE_APP_CHECK_SITE_KEY=

# App-level rate limits are weighted analysis units. Compare consumes 2 units.
USER_HOURLY_UNITS=8
USER_DAILY_UNITS=30
